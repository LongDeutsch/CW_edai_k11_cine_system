# UI lakehouse. Stage đầu chỉ nhận source. Image chạy không có toolchain cài đặt.

FROM python:3.12-slim AS builder

WORKDIR /build
COPY storage /build/storage

FROM python:3.12-slim

WORKDIR /app
COPY --from=builder /build/storage /app/storage
ENV PYTHONPATH=/app
EXPOSE 8088

CMD ["python", "-m", "storage.lakehouse.ui.server", "--host", "0.0.0.0", "--port", "8088"]
