# Giá trị mặc định đã gắn trong docker-compose.yml.
# Đổi ở đây chỉ khi bạn chạy compose với --env-file và đã chuyển sang biến.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
KAFKA_EXTERNAL_PORT=19092
KAFKA_UI_PORT=8085
MINIO_BUCKET=external-source-lake
KAFKA_TOPIC=movie.playback.heartbeat
