# Giá trị mặc định đã gắn trong docker-compose.yml.
# Đổi ở đây chỉ khi bạn chạy compose với --env-file và đã chuyển sang biến.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
KAFKA_EXTERNAL_PORT=19092
KAFKA_UI_PORT=8085
MINIO_BUCKET=external-source-lake
KAFKA_TOPIC=movie.playback.heartbeat

# Vector DB (Qdrant) cổng host tránh đụng độ 6333 mặc định
QDRANT_REST_PORT=16333
QDRANT_GRPC_PORT=16334
QDRANT_URL=http://127.0.0.1:16333

# Tên thư viện trên https://ollama.com/ , gồm tag. Đổi model chat chỉ sửa OLLAMA_MODEL rồi make llm-pull.
# OLLAMA_EMBED_MODEL là model embedding, tách khỏi model chat.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_EMBED_MODEL=nomic-embed-text
